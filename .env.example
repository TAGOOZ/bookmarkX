# Gemini API Key (required for classification)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Bird CLI authentication (for X/Twitter bookmarks)
# Option 1: Chrome profile (requires Chrome to be closed)
BIRD_CHROME_PROFILE=

# Option 2: Manual auth tokens (more reliable)
# Get these from Chrome DevTools > Application > Cookies > x.com
BIRD_AUTH_TOKEN=
BIRD_CT0=
